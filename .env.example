# Copy to .env.local (never commit it) and fill in from Supabase → Project Settings → API Keys.
# On Windows make sure the file is not saved as ".env.local.txt".

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Server only. Used solely for inviting the second user. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_xxx
